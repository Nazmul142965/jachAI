# Set this in your shell; Spring Boot does not load .env files automatically.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
# The connection string carries the cluster and credentials only. The database
# is named here, so the same cluster URI can serve the app and the test suite
# while they work in different databases. Integration tests use their own
# MONGODB_TEST_URI and MONGODB_TEST_DATABASE, and refuse any database whose
# name does not begin with jachai_it_ because they delete documents.
MONGODB_DATABASE=jachai_prod
# The local profile uses the same Atlas URI but a separate jachai_dev database,
# named in application-local.properties. Change that name only when needed.
# LOCAL_MONGODB_DATABASE=jachai_dev
# MONGODB_TEST_URI=<same cluster URI>
# MONGODB_TEST_DATABASE=jachai_it_local
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Optional bootstrap: comma-separated IDs of verified JachAI users permitted platform metadata access.
# PLATFORM_ADMIN_USER_IDS=existing-verified-user-id
APP_PUBLIC_BASE_URL=http://localhost:8080
# Optional Google Identity Services web OAuth client ID. No client secret is needed for ID-token sign-in.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Sandbox-only demo TEAM price; this is not a production commercial price.
DEMO_TEAM_PRICE_BDT=100.00
# SSLCOMMERZ_SANDBOX_STORE_ID=your-sandbox-store-id
# SSLCOMMERZ_SANDBOX_STORE_PASSWORD=your-sandbox-store-password
# BKASH_SANDBOX_APP_KEY=your-sandbox-app-key
# BKASH_SANDBOX_APP_SECRET=your-sandbox-app-secret
# BKASH_SANDBOX_USERNAME=your-sandbox-username
# BKASH_SANDBOX_PASSWORD=your-sandbox-password
# Optional stable 32+ byte secret for encrypting queued email links; otherwise JWT_SECRET is used.
# MAIL_JOB_ENCRYPTION_KEY=replace-with-another-random-secret-of-at-least-32-bytes
# MAIL_OUTBOX_POLL_MS=15000
REDIS_HOST=localhost
REDIS_PORT=6379
# For cloud Redis, set its username/password and enable TLS if required.
# REDIS_USERNAME=default
# REDIS_PASSWORD=replace-me
# REDIS_SSL_ENABLED=true
# Alternatively set SPRING_DATA_REDIS_URL in the shell/IntelliJ run configuration;
# Spring Boot gives it precedence over host, port, username, and password.
# Keep URLs with credentials out of files and commits.
# Set true once Redis is running. Production enables this by default.
CACHE_ENABLED=false
# Redis speeds up revocation checks; MongoDB remains the durable source of truth.
REDIS_REVOCATION_ENABLED=false
# Set true when Redis is running; production enables this by default.
RATE_LIMIT_ENABLED=false
# Optional comma-separated literal IPs/CIDRs for reverse proxies directly trusted to set X-Forwarded-For.
# Leave empty for direct connections. See DEPLOYMENT.md before enabling.
# TRUSTED_PROXY_CIDRS=10.0.0.0/24,2001:db8::/48
# AI_PROVIDER=none (disabled), ollama (local), or google-genai (Gemini drafts)
AI_PROVIDER=none
# Upper bound across all personal-practice AI generations per UTC day, independent of the per-user 20 limit.
PRACTICE_AI_GLOBAL_DAILY_LIMIT=100
# Set AI_TUTOR_PROVIDER=groq to use Groq for tutor while drafts use Gemini.
# AI_TUTOR_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.8-flash
# GROQ_API_KEY=replace-me
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=openai/gpt-oss-20b
# Production email settings:
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=replace-me
# MAIL_PASSWORD=replace-me
# MAIL_FROM=no-reply@example.com
