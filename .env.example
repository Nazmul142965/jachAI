# Set this in your shell; Spring Boot does not load .env files automatically.
# All values must be set in the deployment environment / secret manager.
# NEVER commit actual credentials to this file or the repository.

# MongoDB Atlas: cluster + credentials ONLY (no database name in URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
# Production database name (set in application-prod.properties)
MONGODB_DATABASE=jachai_prod

# JWT: at least 32 random bytes, MUST be stable across restarts
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional bootstrap: comma-separated IDs of VERIFIED JachAI users permitted platform metadata access
# PLATFORM_ADMIN_USER_IDS=existing-verified-user-id

# Public HTTPS origin — REQUIRED for OAuth redirects, payment callbacks, email links
APP_PUBLIC_BASE_URL=https://jachai.example.com

# Google Identity Services Web OAuth client ID (authorized JavaScript origin = APP_PUBLIC_BASE_URL)
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Redis (required in production for rate limits, revocation cache, AI quotas, published version cache)
# Use SPRING_DATA_REDIS_URL (redis://user:pass@host:port) OR individual settings:
REDIS_HOST=your-redis-host
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=replace-me
# REDIS_SSL_ENABLED=true
# SPRING_DATA_REDIS_URL=redis://user:pass@host:port

# SMTP (required for email delivery: verification, reset, notifications)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com
# Optional separate encryption key for queued email payloads (recommended)
MAIL_JOB_ENCRYPTION_KEY=replace-with-another-random-secret-of-at-least-32-bytes

# Trusted reverse proxy CIDRs (comma-separated literal IPs/CIDRs)
# Leave empty for direct connections. See SYSTEM.md before enabling.
# TRUSTED_PROXY_CIDRS=10.0.0.0/24,2001:db8::/48

# Sandbox-only payment gateways (NEVER live credentials)
# SSLCOMMERZ sandbox
SSLCOMMERZ_SANDBOX_STORE_ID=your-sandbox-store-id
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=your-sandbox-store-password
# Direct bKash tokenized sandbox
BKASH_SANDBOX_APP_KEY=your-sandbox-app-key
BKASH_SANDBOX_APP_SECRET=your-sandbox-app-secret
BKASH_SANDBOX_USERNAME=your-sandbox-username
BKASH_SANDBOX_PASSWORD=your-sandbox-password
# Demo TEAM price (BDT)
DEMO_TEAM_PRICE_BDT=100.00

# AI providers (optional until tested)
# AI_PROVIDER=none (disabled), ollama (local), or google-genai (Gemini drafts)
AI_PROVIDER=none
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.8-flash
AI_TUTOR_PROVIDER=none
GROQ_API_KEY=replace-me
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
PRACTICE_AI_GLOBAL_DAILY_LIMIT=100

# Support center public display (optional)
SUPPORT_EMAIL=support@jachai.example.com
SUPPORT_PHONE=+1-555-123-4567
SUPPORT_WHATSAPP_NUMBER=+15551234567

# --- LOCAL DEVELOPMENT ONLY (do not use in production) ---
# Local profile uses same Atlas URI but separate jachai_dev database
# LOCAL_MONGODB_DATABASE=jachai_dev
# MONGODB_TEST_URI=<same cluster URI>
# MONGODB_TEST_DATABASE=jachai_it_local
# AI_PROVIDER=none
# CACHE_ENABLED=false
# REDIS_REVOCATION_ENABLED=false
# RATE_LIMIT_ENABLED=false
# APP_PUBLIC_BASE_URL=http://localhost:8080

# --- ISOLATED FACULTY DEMO PREVIEW ONLY ---
# Use SPRING_PROFILES_ACTIVE=demo, never prod or local, with a dedicated
# DEMO_MONGODB_DATABASE=jachai_demo_faculty (never a real-data database).
# Set SERVER_ADDRESS=0.0.0.0 and APP_PUBLIC_BASE_URL to the preview HTTPS origin.
# DEMO_PUBLIC_ACCESS=true enables six workspace roles plus a platform-admin
# preview role only when the demo database name starts with jachai_demo_.
# On the separate real-data deployment, set DEMO_PREVIEW_URL=https://<demo-host>
# to show workspace role links on its sign-in page. Do not point it to this deployment.
# Anyone with the preview URL can change shared disposable demo data.
# Do not configure payment credentials or live AI on this preview.
