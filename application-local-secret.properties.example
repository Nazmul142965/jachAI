# Local secrets for development.
#
# Copy this file to  application-local-secret.properties  in the same folder
# (beside pom.xml), fill in the two values, and the application reads them on
# every run — from IntelliJ, from mvnw, from anywhere — with nothing to set in a
# run configuration.
#
# The real file is already in .gitignore and must never be committed.
#
# These are plain Spring property names, not environment variables, so there is
# no ";" separator to get wrong and no quoting rules. One setting per line.
#
# Environment variables still work and still win over this file, which is how
# deployment supplies them. This file is only a convenience for a workstation.

# Signs access tokens, and encrypts queued email payloads by default.
# Any random string of 32 characters or more. Change it for anything real.
app.jwt.secret=replace-with-your-own-random-string-of-32-characters-or-more

# The cluster and credentials. The database name is NOT part of this: it comes
# from spring.data.mongodb.database in application.properties, which defaults to
# "jachai". Percent-encode a password containing @ : / ? # or % — or avoid those
# characters entirely, which is simpler.
spring.data.mongodb.uri=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0

# Uncomment to work in a different database without touching the URI.
# spring.data.mongodb.database=jachai

# Uncomment when you have the credentials. Each is optional; the application
# starts without them and reports the feature as unavailable.
# app.auth.google.client-id=
# spring.ai.google.genai.api-key=
